{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-contact-form",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.jerrylundahl.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://jerrylundahl.com,https://www.jerrylundahl.com",
    "EXPECTED_HOSTNAMES": "jerrylundahl.com,www.jerrylundahl.com"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": ["jerry.lundahl@hotmail.com"],
      "allowed_sender_addresses": ["portfolio@jerrylundahl.com"]
    }
  ]
}
